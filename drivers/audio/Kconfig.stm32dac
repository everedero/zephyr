config AUDIO_DAC_STM32
	bool "STM32 DAC audio playback driver"
	default y
	depends on DT_HAS_ST_STM32_DAC_AUDIO_ENABLED
	select DAC
	select COUNTER
	help
	  Enable audio playback through an STM32 on-chip DAC channel.

config AUDIO_DAC_STM32_DMA
	bool "Use DMA to feed the DAC"
	depends on AUDIO_DAC_STM32
	default y
	select DMA
	help
	  Feed the DAC from a circular DMA channel, one interrupt per
	  half-buffer. Requires a "dmas" property on the node.

	  Disable to fall back to a per-sample timer interrupt that writes
	  every sample by hand: same audio, far more CPU, which makes the
	  cost of DMA visible in a trace.

config AUDIO_DAC_STM32_TRACE_GPIO
	bool "Toggle a GPIO around the audio callbacks"
	depends on AUDIO_DAC_STM32
	select GPIO
	help
	  Drive the "trace-gpios" pin high on entry to the callback and low on
	  exit, with a single BSRR store. On a scope the pin's duty cycle is the
	  CPU cost of the callback: the same measurement the CTF markers make,
	  but without touching the trace buffer or the interrupt being measured.

	  The pin is driven active high, whatever the devicetree flags say.

config AUDIO_DAC_STM32_MAX_BLOCK_SIZE
	int "STM32 DAC audio maximum block size in bytes"
	default 512
	range 2 32766
	help
	  The driver is using double buffering: the buffer holds two blocks,
	  so the RAM cost per instance is twice this value.
